VITE_APP_NAME="OleOS"
# Keep APP_ORIGIN equal to the address where users open OleOS.
APP_ORIGIN="http://localhost:5173"
API_PORT=3001
VITE_PORT=5173
NODE_ENV="development"
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
DATABASE_URL="file:./dev.db"
# Optional: use a persistent Turso/libSQL database in production.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Add this exact URL under OAuth2 > Redirects in the Discord Developer Portal.
DISCORD_REDIRECT_URI="http://localhost:3001/api/auth/discord/callback"
# Set true only when deployed behind a trusted HTTPS reverse proxy.
TRUST_PROXY="false"
# Comma-separated Discord user IDs allowed to moderate OleOS chats and accounts.
ADMIN_DISCORD_IDS=""


